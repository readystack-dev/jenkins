      'b5e5e35cf93ad3b818a983916cbcdf3f7866699410a4df923e6a2968ecc3a448  plain-credentials.jpi' \
      '06ea312ee4c012ed5c2b8f091a6e6f7db7ccc714ab25d25d751f30dc22ad8307  plugin-util-api.jpi' \
      '2b7aa7809e0f656afce98c0b6a0a9b62885af6ae85ad90bed67a4f18f18e8354  prism-api.jpi' \
      '1336472987daa2fa912210aba00e1e37b739ce03f75c973a6794d1a0f55c0326  scm-api.jpi' \
      'c2292e200c5796675c16d19325469aac4a5460c7ad23974952b9823f62066f6a  script-security.jpi' \
      'bfa595a283634c8dd63aa8d1b039cf3d3f52e0952048058fc0b9a4826ca06508  snakeyaml-api.jpi' \
      '7b4d035b05b331038f3dfa99ddfef0cabbacede8f0ad2a6ca9611fb0844108a9  ssh-credentials.jpi' \
      'a0a5db44f2cb082a9ec6572c088340521f033fff8c351fc7eba9ef7f07dbbf8d  structs.jpi' \
      '12e214ea694469a4461b55881ecb4074ae5dfb04797dbc0dad390f6f4bc75aaf  variant.jpi' \
      'fca0ce7cd19274833df226cd6746d71ce4025b784a81bd5b8512730f5d34a9df  woodstox-core-api.jpi' \
      '7b94227c1afa01bb262c14919ad4a333412f1b51d947c0f21909ec2daff357dc  workflow-aggregator.jpi' \
      '79001c37c117dc29cd2de2b19684d19e6fe77aa5439b609ba2111de5a81df9fb  workflow-api.jpi' \
      '2bf01de85b659efe382560237e3c49760cb6e539074e6af31afcd5e7c2787527  workflow-basic-steps.jpi' \
      '2af278f3012f294165db715bfa608045feaf781a6c7c85b5d7ab1ee5b707f021  workflow-cps.jpi' \
      'a0f0f1464ce3592f76d0f0079ce9fc2d4272594f995bf3d1a7ede4cd5031452e  workflow-durable-task-step.jpi' \
      'e67c1ab5862b0d0a24c478feea4a420af787de08721853b014b58f8b5b8d04ab  workflow-job.jpi' \
      'af26afd93b5d730d203d8f58d1e104712ad1a7ddcf6837886d3272b1c0057e46  workflow-multibranch.jpi' \
      '532fc247cba83845df3c7fccaabfc3cb1f637729b145211728bcb974a3a67552  workflow-scm-step.jpi' \
      '887491de444174228471993b0b2db958db2e7fb577857c8516c58e9618049896  workflow-step-api.jpi' \
      '167b31b5f1e79c1e7becf13bd1e53add5f29b6944a634572abe538407999dd02  workflow-support.jpi' \
    | sha256sum -c - && \
    test "$(ls -1A /plugins | wc -l)" = 63
RUN cd /src && mvn -B -e -am -pl war,bom -Pquick-build -Dmaven.repo.local=/m2 clean install
RUN set -eu; P=/plugins/jackson2-api.jpi; N=2.22.3; W=/tmp/rs-jackson2; rm -rf "$W"; mkdir -p "$W/x"; cd "$W/x"; jar --extract --file "$P"; O=$(ls WEB-INF/lib | sed -n 's/^jackson-core-\([0-9][0-9.]*\)\.jar$/\1/p'); [ -n "$O" ] || { echo "jackson2-api.jpi has no WEB-INF/lib/jackson-core-*.jar" >&2; exit 1; }; if [ "$(printf '%s\n%s\n' "$O" "$N" | sort -V | head -n1)" = "$N" ]; then echo "jackson2-api already bundles jackson $O (>= $N): overlay not applied"; else case "$O" in 2.22.*) ;; *) echo "jackson2-api bundles jackson $O, outside 2.22.x: this overlay only moves within 2.22" >&2; exit 1;; esac; for s in com/fasterxml/jackson/core/jackson-core=8a501126a385b25841915d839508f8a66e2a0dbc8a6709d055ef3b3e852b094c com/fasterxml/jackson/core/jackson-databind=556db5439e206114346043f68d200497dc96a0bca62a360a81784092ebd0e0a9 com/fasterxml/jackson/dataformat/jackson-dataformat-cbor=0ed7167fdc432a409459602fba668eeb9a8d3623353439433970ee916336fc2b com/fasterxml/jackson/dataformat/jackson-dataformat-csv=f5585e657bcf62d77cc4d584571f344aa3973699aa1db1466496aeae96462e26 com/fasterxml/jackson/dataformat/jackson-dataformat-toml=b64f5bd51701daeefcd1a2c3e4f87a95a2ed61df18fa9c9ad2aef67a46143678 com/fasterxml/jackson/dataformat/jackson-dataformat-xml=8b99f4a11761246f2d721f02d2865dcca32dd8101082ebfbc3c16133b6c0d3e0 com/fasterxml/jackson/dataformat/jackson-dataformat-yaml=2bcbc3b9abaefbeba11409b9e30ec35ed7071a61a47c8c2a9c688e40e45b90f9 com/fasterxml/jackson/datatype/jackson-datatype-jdk8=f223061a5aaecdc9506458143807c73bcd1a744d6b3bbb8da4703a0abc408f7d com/fasterxml/jackson/datatype/jackson-datatype-json-org=15955136df8ef95adcf1be6c9cfb877326cd4cd997f5f58c36ac6aeef282ffdd com/fasterxml/jackson/datatype/jackson-datatype-jsr310=ec7052ee48c9d873bb8148338a643f02cf89c01d035dd219411473030d6d2b22 com/fasterxml/jackson/module/jackson-module-jakarta-xmlbind-annotations=ce2bbc8d3f27e9321a80e30231288aa0c340c100c45eb413efffbab7b98f3c1e com/fasterxml/jackson/module/jackson-module-jaxb-annotations=cdf7277e57e6aeb8414acdc1ca2b5de61e158db9c96d2a55f6f02285b87dda85 com/fasterxml/jackson/module/jackson-module-parameter-names=3f085667cd7b2dd9794a837b6e4a5c57779132bfc37b49b5c457870eee9d60ba; do p=${s%%=*}; h=${s#*=}; a=${p##*/}; [ -f "WEB-INF/lib/$a-$O.jar" ] || { echo "jackson2-api.jpi has no WEB-INF/lib/$a-$O.jar" >&2; exit 1; }; curl -fsSL -o "WEB-INF/lib/$a-$N.jar" "https://repo1.maven.org/maven2/$p/$N/$a-$N.jar"; echo "$h  WEB-INF/lib/$a-$N.jar" | sha256sum -c --quiet -; rm "WEB-INF/lib/$a-$O.jar"; done; L=$(ls WEB-INF/lib | grep -F -- "-$O.jar" || true); [ -z "$L" ] || { echo "jackson2-api.jpi still bundles: $L" >&2; exit 1; }; jar --list --file "$P" | grep -v '/$' | sed "s/-$O\.jar\$/-$N.jar/" > "$W/order"; jar --create --no-manifest --date=2026-08-17T11:08:00Z --file "$W/new.jpi" @"$W/order"; mv "$W/new.jpi" "$P"; echo "jackson2-api.jpi: bundled jackson $O -> $N"; fi; cd /; rm -rf "$W"; for f in /plugins/*.jpi /plugins/*.hpi; do [ -f "$f" ] || continue; for v in $(unzip -Z1 "$f" | sed -n 's|^WEB-INF/lib/jackson-\(core\|databind\)-\([0-9][0-9.]*\)\.jar$|\2|p'); do [ "$(printf '%s\n%s\n' "$v" "$N" | sort -V | head -n1)" = "$N" ] || { echo "$f bundles jackson-core/databind $v, below $N" >&2; exit 1; }; done; done; echo "jackson-core/databind floor $N holds across $(ls /plugins | wc -l) plugins"
FROM maven:3.9.8-eclipse-temurin-21@sha256:de18e4e51396ad9266f76669779ed6d6b49fbb0f45ed6f39169d87378d548d7d AS builddebvendor
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get -y --download-only --no-install-recommends install \
      git ca-certificates curl unzip && \
    mkdir -p /build-debs && (cp /var/cache/apt/archives/*.deb /build-debs/ 2>/dev/null || true) && echo "vendored $(ls -1 /build-debs/*.deb 2>/dev/null | wc -l) build-debs"
# chiselled runtime (runtime_base): the files the slices need, cut from Ubuntu's own .debs by Canonical's chisel
FROM ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289 AS chiselcut
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl file zstd && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/chisel.tgz https://github.com/canonical/chisel/releases/download/v1.5.1/chisel_v1.5.1_linux_amd64.tar.gz && \
    echo "89612f46de83e850aae11fca26a32a22cc2964891f2cc538211b906787d2b83e4496fa203a5074e06a9932f1fbe84a73  /tmp/chisel.tgz" | sha384sum -c - && tar -xzf /tmp/chisel.tgz -C /usr/local/bin chisel && \
    curl -fsSL -o /tmp/releases.tgz https://github.com/canonical/chisel-releases/archive/f2600d3aa90123db6d44bb1441a99afc8b5847d9.tar.gz && \
    echo "e5b4484bb283149ed7fc0f42ad2194fed28cae0bf1036704853d60ec31298bef  /tmp/releases.tgz" | sha256sum -c - && \
    mkdir -p /opt/chisel-releases && tar -xzf /tmp/releases.tgz -C /opt/chisel-releases --strip-components=1
RUN mkdir -p /rootfs /cache && XDG_CACHE_HOME=/cache chisel cut --release /opt/chisel-releases --root /rootfs base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying coreutils_bins sed_bins diffutils_bins git_bins git_http-support libc-bin_locale fontconfig_bins fonts-dejavu-core_fonts libfreetype6_libs zlib1g_libs libgcc-s1_libs libstdc++6_libs
RUN set -eu; mkdir -p /chisel/debs /rootfs/var/lib/dpkg; : > /tmp/status; : > /chisel/packages.tsv; \
    for f in /cache/chisel/sha256/* /cache/chisel/sha512/*; do [ -f "$f" ] && file "$f" | grep -q "Debian binary package" || continue; \
      p=$(dpkg-deb -f "$f" Package); v=$(dpkg-deb -f "$f" Version); \
      cp "$f" "/chisel/debs/${p}_${v}.deb"; printf '%s\t%s\t%s\n' "$p" "$v" "$(sha256sum < "$f" | cut -c1-64)" >> /chisel/packages.tsv; done; \
    [ -s /chisel/packages.tsv ] || { echo "no .deb found in the chisel cache" >&2; exit 1; }; \
    LC_ALL=C sort -o /chisel/packages.tsv /chisel/packages.tsv; \
    cut -f1,2 /chisel/packages.tsv | while IFS="$(printf '\t')" read -r p v; do \
      dpkg-deb -f "/chisel/debs/${p}_${v}.deb" | sed '/^Package:/a Status: install ok installed' >> /tmp/status; echo >> /tmp/status; done; \
    install -m 0644 /tmp/status /rootfs/var/lib/dpkg/status; \
    mkdir -p /rootfs/var/lib/dpkg/info; [ -s /rootfs/var/lib/chisel/manifest.wall ] || \
      { echo "no chisel manifest (/var/lib/chisel/manifest.wall): the base-files_chisel slice is missing" >&2; exit 1; }; \
    zstd -dc /rootfs/var/lib/chisel/manifest.wall | grep '"kind":"path"' | \
      sed -n 's/.*"path":"\([^"]*\)".*"slices":\[\([^]]*\)\].*/\1 \2/p' | \
      while read -r path slices; do path=${path%/}; if [ -z "$path" ]; then continue; fi; \
        for s in $(echo "$slices" | tr -d '"' | tr ',' ' '); do echo "$path" >> "/rootfs/var/lib/dpkg/info/${s%%_*}.list"; done; done; \
    cut -f1 /chisel/packages.tsv | while read -r p; do l="/rootfs/var/lib/dpkg/info/$p.list"; [ -f "$l" ] || : > "$l"; \
      LC_ALL=C sort -u -o "$l" "$l"; \
      while read -r f; do if [ -f "/rootfs$f" ] && [ ! -L "/rootfs$f" ]; then (cd /rootfs && md5sum "${f#/}"); fi; done < "$l" \
        > "/rootfs/var/lib/dpkg/info/$p.md5sums"; done; \
    [ "$(ls /rootfs/var/lib/dpkg/info/*.md5sums | wc -l)" = "$(wc -l < /chisel/packages.tsv)" ] || \
      { echo "/var/lib/dpkg/info does not name every package of the cut" >&2; exit 1; }; \
    { echo "chisel v1.5.1"; echo "chisel-releases f2600d3aa90123db6d44bb1441a99afc8b5847d9"; for s in base-files_base base-files_release-info base-files_chisel base-passwd_data ca-certificates_data tzdata_zoneinfo dash_bins coreutils_output-of-entire-files coreutils_env coreutils_echo coreutils_test coreutils_tr-utility coreutils_sort coreutils_head coreutils_tail coreutils_cut coreutils_printf coreutils_working-context coreutils_system-context coreutils_basename coreutils_dirname coreutils_rm-utility coreutils_ln-utility coreutils_readlink coreutils_date coreutils_timeout coreutils_delaying coreutils_bins sed_bins diffutils_bins git_bins git_http-support libc-bin_locale fontconfig_bins fonts-dejavu-core_fonts libfreetype6_libs zlib1g_libs libgcc-s1_libs libstdc++6_libs; do echo "$s"; done; } > /chisel/slices.txt; \
    tar --sort=name --numeric-owner --format=posix --pax-option=delete=atime,delete=ctime -cf /chisel/rootfs.tar -C /rootfs . && \
    echo "chiselled rootfs: $(wc -l < /chisel/packages.tsv) packages, $(du -sh /rootfs | cut -f1)"
FROM scratch AS export
COPY --from=jvendor /src /jenkins-src
COPY --from=jvendor /m2 /caches/m2
COPY --from=jvendor /corepack /caches/corepack
COPY --from=jvendor /plugins /caches/plugins
COPY --from=builddebvendor /build-debs /build-debs
COPY --from=chiselcut /chisel /chisel
